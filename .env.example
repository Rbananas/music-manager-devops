# Backend
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Backend database, authentication, and upload settings.
MONGODB_URI=mongodb://localhost:27017/music_manager
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Grafana (used by Docker Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-local-password
